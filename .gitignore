# Local leftovers from the primitives showcase, which moved to the docs repo.
# The directory itself is gone from this tree, and it took its own .gitignore
# with it, so without this line a `git add -A` sweeps in hundreds of MB of
# generated .stl and .png that were only ever build output.
primitives_showcase/
.env
.env.*
!.env.example
